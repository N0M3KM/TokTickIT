generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionEventType {
  CREATE
  EDIT
  STATUS
}

enum WorkflowEventKind {
  OWNER
  PRIORITY
  STATUS
  REQUESTER_INDICATION
}

// ---------------------------------------------------------------------------
// Reference tables (unchanged from Lab 2)
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model RelatedSystem {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// User — replaces DevRequester from Lab 2 (BR-24, BR-25)
// Passwords hashed with bcrypt (cost 12); never stored in plaintext.
// ---------------------------------------------------------------------------

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  submittedTickets   Ticket[]        @relation("TicketRequester")
  ownedTickets       Ticket[]        @relation("TicketOwner")
  publicComments     PublicComment[]
  internalNotes      InternalNote[]
  performedActions   ActionTaken[] @relation("ActionPerformer")
  assignedActions    ActionTaken[] @relation("ActionAssignee")
  updatedActions     ActionTaken[] @relation("ActionEditor")
  actionRevisions    ActionRevision[]
  workflowEvents     TicketWorkflowEvent[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Ticket — updated for Lab 3 (requesterId now → User; new fields added)
// ---------------------------------------------------------------------------

model Ticket {
  id                   Int          @id @default(autoincrement())
  ticketNumber         String       @unique
  requesterId          Int
  ticketOwnerId        Int?
  categoryId           Int
  relatedSystemId      Int?
  summary              String
  description          String
  requestedPriority    Priority     @default(MEDIUM)
  itPriority           Priority     @default(MEDIUM)
  currentStatus        TicketStatus @default(NEW)
  requesterResolvedAt  DateTime?
  ticketDate           DateTime     @default(now())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  version              Int          @default(1)
  resolvedAt           DateTime?    @db.Timestamptz(3)
  reopenedAt           DateTime?    @db.Timestamptz(3)
  resolutionTimeEstimated Boolean   @default(false)

  requester      User           @relation("TicketRequester", fields: [requesterId],   references: [id])
  ticketOwner    User?          @relation("TicketOwner",     fields: [ticketOwnerId], references: [id])
  category       Category       @relation(fields: [categoryId],     references: [id])
  relatedSystem  RelatedSystem? @relation(fields: [relatedSystemId], references: [id])
  attachments    Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]
  actions        ActionTaken[]
  workflowEvents TicketWorkflowEvent[]

  @@index([requesterId])
  @@index([ticketOwnerId])
  @@index([ticketNumber])
  @@index([currentStatus])
  @@index([requestedPriority])
  @@index([itPriority])
  @@index([categoryId])
  @@index([createdAt])
  @@index([requesterId, currentStatus])
  @@index([requesterId, updatedAt, id])
  @@index([currentStatus, resolvedAt, id])
  @@index([updatedAt, id])
  @@index([ticketOwnerId, currentStatus])
}

model ActionTaken {
  id Int @id @default(autoincrement())
  ticketId Int
  actionAt DateTime @db.Timestamptz(3)
  description String
  result String?
  performedById Int
  assigneeId Int
  followUpRequired Boolean @default(false)
  followUpNote String?
  attachmentNotes String?
  status ActionStatus @default(PLANNED)
  cancellationReason String?
  version Int @default(1)
  updatedById Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  idempotencyKey String @db.Uuid
  requestFingerprint String
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy User @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  assignee User @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  updatedBy User @relation("ActionEditor", fields: [updatedById], references: [id], onDelete: Restrict)
  revisions ActionRevision[]
  @@unique([performedById, ticketId, idempotencyKey])
  @@index([ticketId, actionAt, id])
  @@index([assigneeId, status, actionAt, id])
}

model ActionRevision {
  id Int @id @default(autoincrement())
  actionId Int
  version Int
  editorId Int
  eventType ActionEventType
  snapshot Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  action ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)
  editor User @relation(fields: [editorId], references: [id], onDelete: Restrict)
  @@unique([actionId, version])
  @@index([actionId, createdAt, id])
}

model TicketWorkflowEvent {
  id Int @id @default(autoincrement())
  ticketId Int
  actorId Int
  kind WorkflowEventKind
  before Json
  after Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt, id])
}

// ---------------------------------------------------------------------------
// Attachment (unchanged from Lab 2)
// ---------------------------------------------------------------------------

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storageFilename  String    @unique
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime  @default(now())
  removedAt        DateTime?
  removalReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([removedAt])
}

// ---------------------------------------------------------------------------
// PublicComment — visible to Requester, IT Staff, Administrator (BR-04)
// ---------------------------------------------------------------------------

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// InternalNote — visible only to IT Staff and Administrator (BR-04)
// ---------------------------------------------------------------------------

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}
